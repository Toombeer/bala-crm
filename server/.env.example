# Скопируйте в .env и заполните. Без BALA_SECRET продакшен-режим не запустится.
BALA_ENV=prod
# Секрет для подписи токенов: python -c "import secrets;print(secrets.token_urlsafe(48))"
BALA_SECRET=
# Файл базы данных (в Docker — том /data)
BALA_DB=/data/bala.db
# Сколько часов действует вход
BALA_TOKEN_HOURS=12
# Разрешённые сайты для запросов из браузера (если клиент на другом домене), через запятую
BALA_CORS=
# Ежедневная загрузка курсов НБ РК (1 — да, 0 — нет)
BALA_RATES_AUTO=1
# Часовой пояс для «сегодня», часов от UTC (Казахстан: 5)
BALA_TZ_OFFSET=5
# Попыток входа с одного IP за 15 минут
BALA_LOGIN_ATTEMPTS=10
# Домен для HTTPS (используется Caddy в docker-compose)
DOMAIN=crm.example.kz
